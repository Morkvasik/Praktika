<Window x:Class="Задание_4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт финансов" Height="600" Width="800">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="Grid1"
                  Grid.Row="0"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  SelectionChanged="Grid1_SelectionChanged"
                  Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Название"/>
            <TextBox x:Name="Name1" Margin="0,3,0,7"/>

            <TextBlock Text="Тип записи"/>
            <ComboBox x:Name="Type1" SelectedIndex="0"
                      Margin="0,3,0,7">
                <ComboBoxItem Content="Доход"/>
                <ComboBoxItem Content="Расход"/>
            </ComboBox>

            <TextBlock Text="Сумма"/>
            <TextBox x:Name="Amount1" Margin="0,3,0,7"/>

            <TextBlock Text="Дата"/>
            <TextBox x:Name="Date1" Margin="0,3,0,7"/>

            <TextBlock Text="Описание"/>
            <TextBox x:Name="Info1" Margin="0,3,0,10"/>

            <WrapPanel>
                <Button Content="Добавить" Width="100"
                        Margin="0,0,5,0" Click="Add_Click"/>

                <Button Content="Изменить" Width="100"
                        Margin="0,0,5,0" Click="Edit_Click"/>

                <Button Content="Удалить" Width="100"
                        Margin="0,0,5,0" Click="Delete_Click"/>

                <Button Content="Очистить" Width="100"
                        Click="Clear_Click"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>