<Window x:Class="Задание_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека" Height="500" Width="750">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="Search1"
                     Width="300"
                     Height="30"
                     VerticalContentAlignment="Center"
                     Margin="0,0,10,0"/>

            <Button Content="Найти"
                    Width="90"
                    Margin="0,0,5,0"
                    Click="Search_Click"/>

            <Button Content="Все книги"
                    Width="100"
                    Click="All_Click"/>
        </StackPanel>

        <DataGrid x:Name="Grid1"
                  Grid.Row="1"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0,0,0,10"/>

        <WrapPanel Grid.Row="2">
            <Button Content="Взять книгу"
                    Width="120"
                    Margin="0,0,10,0"
                    Click="Rent_Click"/>

            <Button Content="Вернуть книгу"
                    Width="120"
                    Click="Return_Click"/>
        </WrapPanel>
    </Grid>
</Window>