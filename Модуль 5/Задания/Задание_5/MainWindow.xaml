 <Window x:Class="Задание_5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор"
        Height="450" Width="320"
        ResizeMode="NoResize">

    <Grid Background="#EEEEEE" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Display"
                   Text="0"
                   FontSize="36"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Margin="10"/>

        <UniformGrid Grid.Row="1" Columns="4" Rows="4">
            <Button Content="C" Click="Clear_Click" FontSize="20"/>
            <Button Content="/" Click="Operation_Click" FontSize="20"/>
            <Button Content="*" Click="Operation_Click" FontSize="20"/>
            <Button Content="-" Click="Operation_Click" FontSize="20"/>

            <Button Content="7" Click="Number_Click" FontSize="20"/>
            <Button Content="8" Click="Number_Click" FontSize="20"/>
            <Button Content="9" Click="Number_Click" FontSize="20"/>
            <Button Content="+" Click="Operation_Click" FontSize="20"/>

            <Button Content="4" Click="Number_Click" FontSize="20"/>
            <Button Content="5" Click="Number_Click" FontSize="20"/>
            <Button Content="6" Click="Number_Click" FontSize="20"/>
            <Button Content="0" Click="Number_Click" FontSize="20"/>

            <Button Content="1" Click="Number_Click" FontSize="20"/>
            <Button Content="2" Click="Number_Click" FontSize="20"/>
            <Button Content="3" Click="Number_Click" FontSize="20"/>
            <Button Content="=" Click="Equals_Click"
                    FontSize="20"
                    Background="LightBlue"/>
        </UniformGrid>
    </Grid>
</Window>