<Window x:Class="Задание_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список дел" Height="450" Width="500">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="TaskText"
                     Width="300"
                     Height="30"
                     VerticalContentAlignment="Center"/>

            <Button Content="Добавить"
                    Width="100"
                    Margin="10,0,0,0"
                    Click="Add_Click"/>
        </StackPanel>

        <ListBox x:Name="TaskList"
         Grid.Row="1"
         FontSize="16"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,10,0,0">

            <Button Content="Выполнено"
                    Width="120"
                    Height="30"
                    Click="Complete_Click"/>

            <Button Content="Удалить"
                    Width="100"
                    Height="30"
                    Margin="10,0,0,0"
                    Click="Delete_Click"/>
        </StackPanel>
    </Grid>
</Window>