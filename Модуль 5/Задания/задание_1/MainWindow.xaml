<Window x:Class="задание_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:задание_1"
        mc:Ignorable="d"
        Title="Задание_1" Height="450" Width="800">
    <Grid Background="#FF79AE42">
        <Button x:Name="LineButton"
                Content="Линия"
                HorizontalAlignment="Left"
                Margin="30,14,0,0"
                VerticalAlignment="Top"
                Width="80"
                Click="Line_Click"/>

            <Button x:Name="CircleButton"
                Content="Круг"
                HorizontalAlignment="Left"
                Margin="120,14,0,0"
                VerticalAlignment="Top"
                Width="80"
                Click="Circle_Click"/>

            <Button x:Name="SquareButton"
                Content="Квадрат"
                HorizontalAlignment="Left"
                Margin="210,14,0,0"
                VerticalAlignment="Top"
                Width="80"
                Click="Square_Click"/>

            <Button x:Name="ClearButton"
                Content="Очистить"
                HorizontalAlignment="Left"
                Margin="301,14,0,0"
                VerticalAlignment="Top"
                Width="80"
                Click="Clear_Click"/>

            <Canvas x:Name="DrawingCanvas"
                Margin="0,55,0,0"
                Background="White"
                MouseLeftButtonDown="Canvas_MouseDown"
                MouseLeftButtonUp="Canvas_MouseUp"
                />
        </Grid>
</Window>
