<Window x:Class="Задание_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление задачами"
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F1F3F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Background="#34495E" Padding="20">
            <TextBlock Text="Управление задачами"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <!-- Основная часть -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Поля ввода -->
            <Border Background="White"
                    Padding="15"
                    CornerRadius="8"
                    Margin="0,0,0,15">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Margin="5">
                        <TextBlock Text="Название задачи"/>
                        <TextBox x:Name="NameBox"
                                 Height="30"
                                 Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5">
                        <TextBlock Text="Приоритет"/>
                        <ComboBox x:Name="PriorityBox"
                                  Height="30"
                                  Margin="0,5,0,0"
                                  SelectedIndex="1">
                            <ComboBoxItem Content="Низкий"/>
                            <ComboBoxItem Content="Средний"/>
                            <ComboBoxItem Content="Высокий"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="5">
                        <TextBlock Text="Дата выполнения"/>
                        <DatePicker x:Name="DateBox"
                                    Height="30"
                                    Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="5">
                        <TextBlock Text="Статус"/>
                        <ComboBox x:Name="StatusBox"
                                  Height="30"
                                  Margin="0,5,0,0"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Новая"/>
                            <ComboBoxItem Content="Выполняется"/>
                            <ComboBoxItem Content="Завершена"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.ColumnSpan="4"
                                Margin="5,10,5,0">
                        <TextBlock Text="Описание задачи"/>
                        <TextBox x:Name="OpisBox"
                                 Height="55"
                                 Margin="0,5,0,0"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Grid.ColumnSpan="4"
                                Margin="5,10,5,0">
                        <TextBlock Text="Выполнение (%)"/>
                        <Slider x:Name="ProgressBox"
                                Minimum="0"
                                Maximum="100"
                                Value="0"
                                TickFrequency="10"
                                IsSnapToTickEnabled="True"
                                Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Кнопки -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="0,0,0,15">

                <Button Content="Добавить"
                        Width="110"
                        Height="35"
                        Margin="0,0,10,0"
                        Click="Add_Click"/>

                <Button Content="Изменить"
                        Width="110"
                        Height="35"
                        Margin="0,0,10,0"
                        Click="Edit_Click"/>

                <Button Content="Удалить"
                        Width="110"
                        Height="35"
                        Click="Delete_Click"/>
            </StackPanel>

            <!-- Таблица задач -->
            <DataGrid x:Name="TaskTable"
                      Grid.Row="2"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionChanged="TaskTable_SelectionChanged"
                      Background="White">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="№"
                                        Binding="{Binding Id}"
                                        Width="45"/>

                    <DataGridTextColumn Header="Задача"
                                        Binding="{Binding Name}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Приоритет"
                                        Binding="{Binding Priority}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Срок"
                                        Binding="{Binding DueDate}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Статус"
                                        Binding="{Binding Status}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Выполнено, %"
                                        Binding="{Binding Progress}"
                                        Width="110"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Уведомления -->
            <TextBlock x:Name="NoticeText"
                       Grid.Row="3"
                       Text="Здесь будут уведомления о сроках выполнения задач."
                       FontSize="14"
                       Foreground="#C0392B"
                       TextWrapping="Wrap"
                       Margin="0,15,0,0"/>
        </Grid>
    </Grid>
</Window>

