<Window x:Class="Задание_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление проектами"
        Height="550" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F0F0F0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Меню слева -->
        <StackPanel Grid.Column="0" Background="#2D4059">
            <TextBlock Text="Управление"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="15,25,10,30"/>

            <Button Content="Проекты"
                    Height="40"
                    Margin="10,5"
                    Click="Projects_Click"/>

            <Button Content="Задачи"
                    Height="40"
                    Margin="10,5"
                    Click="Tasks_Click"/>

            <Button Content="Сотрудники"
                    Height="40"
                    Margin="10,5"
                    Click="Employees_Click"/>

            <Button Content="Отчёты"
                    Height="40"
                    Margin="10,5"
                    Click="Reports_Click"/>
        </StackPanel>

        <!-- Основная часть окна -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="PageTitle"
                       Text="Проекты"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <!-- Кнопки управления -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="0,0,0,15">

                <Button Content="Добавить"
                        Width="100"
                        Height="32"
                        Margin="0,0,10,0"
                        Click="Add_Click"/>

                <Button Content="Изменить"
                        Width="100"
                        Height="32"
                        Margin="0,0,10,0"
                        Click="Edit_Click"/>

                <Button Content="Удалить"
                        Width="100"
                        Height="32"
                        Click="Delete_Click"/>
            </StackPanel>

            <!-- Таблица проектов -->
            <DataGrid x:Name="MainTable"
                      Grid.Row="2"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Номер"
                                        Binding="{Binding Id}"
                                        Width="60"/>

                    <DataGridTextColumn Header="Название"
                                        Binding="{Binding Name}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Описание"
                                        Binding="{Binding Description}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
