      <DSymName>Visilitsa 2.0.app.dSYM</DSymName>
      <SourceProjectPath>C:\work\Visilitsa\Visilitsa 2.0\Visilitsa 2.0</SourceProjectPath>
      <IsXPCService></IsXPCService>
